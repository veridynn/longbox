{
	"name": "longbox",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "infisical run -- vp dev",
		"build": "vp build",
		"preview": "vp preview",
		"prepare": "vp config && svelte-kit sync || echo ''",
		"check": "vp check && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vp run test:unit -- --run && vp run test:e2e",
		"test:unit": "vp test",
		"test:e2e": "vp exec playwright install && vp exec playwright test"
	},
	"dependencies": {
		"@instantdb/admin": "^1.0.39",
		"@instantdb/svelte": "^1.0.39",
		"@thisux/sveltednd": "^0.4.1",
		"@vercel/functions": "^3.7.5",
		"bits-ui": "^2.18.1",
		"runed": "^0.37.1",
		"svelte-toolbelt": "^0.10.6"
	},
	"devDependencies": {
		"@fontsource-variable/inter": "^5.2.8",
		"@infisical/cli": "^0.43.91",
		"@internationalized/date": "^3.12.1",
		"@lucide/svelte": "^1.16.0",
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-vercel": "^6.3.3",
		"@sveltejs/kit": "^2.61.1",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^24.12.4",
		"clsx": "^2.1.1",
		"playwright": "^1.60.0",
		"shadcn-svelte": "^1.2.7",
		"svelte": "^5.55.9",
		"svelte-check": "^4.4.8",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.2.2",
		"tailwindcss": "^4.3.0",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"vite": "catalog:",
		"vite-plus": "catalog:",
		"vitest": "catalog:",
		"vitest-browser-svelte": "^2.1.1"
	},
	"packageManager": "pnpm@11.5.1"
